{
  "name": "@powerreact/udp-powerbi-visuals",
  "version": "0.1.0",
  "private": true,
  "description": "Univerus Power BI visuals (Neo-Glass / Nocturne template) as presentational Stencil web components following UDP conventions: props in, typed events out, no data fetching.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./components": {
      "types": "./components/index.d.ts",
      "import": "./components/index.js"
    },
    "./components/*": "./components/*",
    "./hydrate": {
      "types": "./hydrate/index.d.ts",
      "import": "./hydrate/index.mjs",
      "require": "./hydrate/index.js"
    },
    "./styles/*": "./src/styles/*",
    "./docs/components.json": "./docs/components.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "components",
    "hydrate",
    "docs",
    "src/styles"
  ],
  "scripts": {
    "build": "stencil build",
    "watch": "stencil build --dev --watch"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-contour": "^4.0.2",
    "d3-geo": "^3.1.1",
    "d3-hexbin": "^0.2.2",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "lucide": "^1.52.0",
    "topojson-client": "^3.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@stencil/core": "^4.45.2",
    "@stencil/react-output-target": "^1.6.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-hexbin": "^0.2.5",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time": "^3.0.4",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5"
  }
}
