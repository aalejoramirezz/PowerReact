AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
UNITY_DOMAIN=https://gateway.unitystage.net
PORT=5000

# Optional: semantic model queried by the React visuals (defaults to the AssetFinda demo model)
# PBI_WORKSPACE_ID=your-workspace-id
# PBI_DATASET_ID=your-dataset-id

# Optional: datasets /api/powerbi/query may answer for (manifests name their own data source).
# Comma-separated dataset ids; defaults to PBI_DATASET_ID. `*` allows any (development only).
# PBI_ALLOWED_DATASETS=your-dataset-id,another-dataset-id
