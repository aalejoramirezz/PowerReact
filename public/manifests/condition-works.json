    {
      "id": "ageing",
      "component": "UniverusColumnChart",
      "grid": {
        "colSpan": 5,
        "rowSpan": 3
      },
      "query": {
        "dax": "EVALUATE\nADDCOLUMNS(\n  DATATABLE(\"Band\", STRING, \"Band Order\", INTEGER, {{\"0–7 days\", 1}, {\"8–30 days\", 2}, {\"31–90 days\", 3}, {\"90+ days\", 4}}),\n  \"Open\", SWITCH([Band Order], 1, [Open WRs Aged 0-7], 2, [Open WRs Aged 8-30], 3, [Open WRs Aged 31-90], [Open WRs Aged 90+])\n)\nORDER BY [Band Order]"
      },
      "fields": {
        "category": "[Band]",
        "value": "[Open]"
      },
      "props": {
        "title": "Open work requests by age",
        "subtitle": "Days since raised · at refresh",
        "info": "How long open work requests have been waiting: one bar per age band, touching because the bands are continuous.",
        "calc": "[Open WRs Aged 0-7] · [8-30] · [31-90] · [90+]",
        "variant": "histogram",
        "categoryLabel": "Age band"
      },
      "sample": [
        {
          "[Band]": "0–7 days",
          "[Band Order]": 1,
          "[Open]": 1
        },
        {
          "[Band]": "8–30 days",
          "[Band Order]": 2,
          "[Open]": 20
        },
        {
          "[Band]": "31–90 days",
          "[Band Order]": 3,
          "[Open]": 31
        },
        {
          "[Band]": "90+ days",
          "[Band Order]": 4,
          "[Open]": 145
        }
      ]
    },
