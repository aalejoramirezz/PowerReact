    {
      "id": "risk",
      "component": "UniverusMatrix",
      "grid": {
        "colSpan": 7,
        "rowSpan": 3
      },
      "query": {
        "dax": "EVALUATE\nSUMMARIZECOLUMNS(\n  ROLLUPADDISSUBTOTAL('asset_register'[Criticality], \"IsCritTotal\"),\n  ROLLUPADDISSUBTOTAL('asset_register'[Condition], \"IsCondTotal\"),\n  KEEPFILTERS(TREATAS({\"Very High\", \"High\", \"Medium\", \"Low\"}, 'asset_register'[Criticality])),\n  KEEPFILTERS(TREATAS({\"Excellent\", \"Good\", \"Average\", \"Poor\", \"Very Poor\"}, 'asset_register'[Condition])),\n  \"Assets\", [Asset Count]\n)"
      },
      "fields": {
        "rows": [
          "'asset_register'[Criticality]"
        ],
        "column": "'asset_register'[Condition]",
        "values": [
          {
            "field": "[Assets]",
            "label": "Assets",
            "heatmap": "sequential"
          }
        ],
        "rowTotals": [
          "[IsCritTotal]"
        ],
        "columnTotal": "[IsCondTotal]"
      },
      "crossFilter": {
        "field": "'asset_register'[Criticality]",
        "emit": true,
        "respect": true
      },
      "props": {
        "title": "Risk matrix: criticality × condition",
        "subtitle": "Assessed assets · darker = more · select a cell to filter the page",
        "info": "Where risk concentrates: assets by criticality and condition grade. Totals come from the model (ROLLUPADDISSUBTOTAL).",
        "calc": "[Asset Count] by Criticality × Condition",
        "rowLevels": [
          "Criticality"
        ],
        "columnHeader": "Condition",
        "rowOrder": [
          "Very High",
          "High",
          "Medium",
          "Low"
        ],
        "columnOrder": [
