      "query": {
        "dax": "EVALUATE\nSUMMARIZECOLUMNS('asset_register'[Criticality], KEEPFILTERS(TREATAS({\"Very High\", \"High\", \"Medium\", \"Low\"}, 'asset_register'[Criticality])), \"Assets\", [Asset Count])\nORDER BY 'asset_register'[Criticality]"
