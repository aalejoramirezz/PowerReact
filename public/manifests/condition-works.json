{
  "$schema": "./manifest.schema.json",
  "schemaVersion": 1,
  "id": "condition-works",
  "title": "Condition & Works (manifest)",
  "eyebrow": "Asset Management · manifest",
  "description": "Lens pages p_condition and p_works on the extended vocabulary: slicers and a report filter, risk matrix with engine totals, histogram, Likert condition profile, scatter, stacked columns, crew heatmap. Sample rows are illustrative.",
  "theme": "auto",
  "dataSource": {
    "workspaceId": "ef45c53d-42d4-48c6-be79-380b8d890c80",
    "semanticModelId": "0db033d0-4f4e-4d72-a280-007d6f17e2ec"
  },
  "layout": {
    "columns": 12,
    "rowMinHeight": 120
  },
  "filters": [
    {
      "field": "'asset_register'[Community]",
      "label": "Community",
      "mode": "dropdown"
    }
  ],
  "visuals": [
    {
      "id": "s-group",
      "component": "UniverusSlicer",
      "grid": {
        "colSpan": 4
      },
      "query": {
        "dax": "EVALUATE\nSUMMARIZECOLUMNS('asset_register'[Asset_Class_Group], \"Assets\", [Asset Count])\nORDER BY 'asset_register'[Asset_Class_Group]"
      },
      "fields": {
        "value": "'asset_register'[Asset_Class_Group]",
        "count": "[Assets]"
      },
      "props": {
        "title": "Class group",
        "mode": "auto",
        "allLabel": "All groups"
      },
      "sample": [
        {
          "asset_register[Asset_Class_Group]": "Core",
          "[Assets]": 970
        },
        {
          "asset_register[Asset_Class_Group]": "Transport",
          "[Assets]": 456
        },
        {
          "asset_register[Asset_Class_Group]": "Utility_Line",
          "[Assets]": 5160
        },
        {
          "asset_register[Asset_Class_Group]": "Utility_Point",
          "[Assets]": 43800
