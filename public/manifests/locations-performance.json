    {
      "id": "coverage",
      "component": "UniverusKpiBullet",
      "grid": {
        "colSpan": 4
      },
      "query": {
        "dax": "EVALUATE\nROW(\"Coverage\", [Condition Coverage %], \"Target\", 0.8)"
      },
      "fields": {
        "value": "[Coverage]",
        "target": "[Target]"
      },
      "props": {
        "title": "Condition assessment coverage",
        "icon": "clipboard-check",
        "thresholds": [
          0.5,
          0.7
        ],
        "info": "Share of assets with a condition assessment, against the 80 % target. Bands: below 50 % poor, 50–70 % fair, above 70 % good.",
        "calc": "[Condition Coverage %] vs 80 %",
        "format": {
          "style": "percent",
          "decimals": 1
        }
      },
      "sample": [
        {
          "[Coverage]": 0.62,
          "[Target]": 0.8
        }
      ]
    },
    {
      "id": "renewal-vs-budget",
      "component": "UniverusKpiVariance",
      "grid": {
        "colSpan": 4
      },
      "query": {
        "dax": "EVALUATE\nROW(\"Liability\", [Renewal Liability 10Y], \"Budget\", [Renewal Budget 10Y])"
      },
      "fields": {
        "actual": "[Liability]",
        "comparison": "[Budget]"
      },
      "props": {
        "title": "Renewal liability vs budget",
        "icon": "dollar",
        "scenario": "BU",
        "actualLabel": "FC",
        "comparisonLabel": "Budget",
        "goodWhen": "lower",
        "caption": "next 10 years",
        "info": "Forecast renewal liability over the next ten years against the renewal budget for the same years, in IBCS notation: forecast solid, budget dotted, variances green when favourable.",
        "calc": "[Renewal Liability 10Y] vs [Renewal Budget 10Y]",
        "format": {
          "style": "compact",
          "decimals": 1
        }
      },
      "sample": [
        {
          "[Liability]": 1620000,
          "[Budget]": 2900000
        }
      ]
    },
    {
      "id": "request-map",
      "component": "UniverusPointMap",
      "grid": {
        "colSpan": 7
      },
      "query": {
        "dax": "EVALUATE\nFILTER(\n  SUMMARIZECOLUMNS(\n    'work_request'[WR_Number],\n    'work_request'[Latitude],\n    'work_request'[Longitude],\n    'work_request'[Service_Type],\n    \"Days Open\", MAX('work_request'[Days_Open])\n  ),\n  NOT ISBLANK('work_request'[Latitude]) && 'work_request'[Latitude] <> 0\n)\nORDER BY [Days Open] DESC"
      },
      "fields": {
        "latitude": "'work_request'[Latitude]",
        "longitude": "'work_request'[Longitude]",
        "category": "'work_request'[WR_Number]",
        "value": "[Days Open]",
        "group": "'work_request'[Service_Type]"
      },
      "crossFilter": {
        "field": "'work_request'[WR_Number]"
      },
      "props": {
        "title": "Work requests on the map",
        "subtitle": "Exact coordinates · bubble area = days open · click to filter",
        "info": "Work requests with a location, at their latitude and longitude. Bubble area shows how long each has been open; colour shows the service type. Requests without coordinates are not shown.",
        "calc": "work_request[Latitude], [Longitude]; MAX([Days_Open])",
        "mark": "bubble",
        "geo": {
          "set": "north-america"
        },
        "categoryLabel": "Work request",
        "valueLabel": "Days open",
        "groupLabel": "Service type",
        "format": {
          "style": "integer"
        },
        "export": {
          "fileName": "work-requests-map"
        }
      },
