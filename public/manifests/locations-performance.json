    {
      "id": "communities",
      "component": "UniverusPointMap",
      "grid": {
        "colSpan": 5
      },
      "query": {
        "dax": "EVALUATE\nFILTER(\n  ADDCOLUMNS(\n    SUMMARIZECOLUMNS('asset_register'[Community], \"Assets\", [Asset Count]),\n    \"Lat\", SWITCH('asset_register'[Community], \"Manhasset-Lakeville Water District\", 40.7943, \"City of Jacksonville\", 30.3322, \"Gibsons\", 49.4006, \"Falls Creek\", -36.865, \"Mt Buller\", -37.145, \"Lake Mountain\", -37.495, BLANK()),\n    \"Lon\", SWITCH('asset_register'[Community], \"Manhasset-Lakeville Water District\", -73.6996, \"City of Jacksonville\", -81.6557, \"Gibsons\", -123.5054, \"Falls Creek\", 147.28, \"Mt Buller\", 146.438, \"Lake Mountain\", 145.879, BLANK())\n  ),\n  NOT ISBLANK([Lat])\n)\nORDER BY [Assets] DESC"
      },
      "fields": {
        "latitude": "[Lat]",
        "longitude": "[Lon]",
        "category": "'asset_register'[Community]",
        "value": "[Assets]"
      },
      "crossFilter": {
        "field": "'asset_register'[Community]"
      },
      "props": {
        "title": "Assets by community",
        "subtitle": "Globe · spike height = assets · click a spike to filter",
        "info": "Each spike stands on a community, its height the number of assets there. Drag the globe, or move between communities with the arrow keys; a click filters the page to that community.",
        "calc": "[Asset Count] by Community, placed by its coordinates",
        "mark": "spike",
        "projection": "globe",
        "geo": {
          "set": "world"
        },
        "categoryLabel": "Community",
        "valueLabel": "Assets",
        "format": {
          "style": "integer"
        },
        "chartHeight": 380,
        "export": {
          "fileName": "assets-by-community"
        }
      },
      "sample": [
        {
          "asset_register[Community]": "Harbour District",
          "[Lat]": 40.71,
          "[Lon]": -74.01,
          "[Assets]": 3820
        },
        {
          "asset_register[Community]": "North Shore",
          "[Lat]": 49.32,
          "[Lon]": -123.07,
          "[Assets]": 1450
        },
        {
          "asset_register[Community]": "Lakeside",
          "[Lat]": 30.33,
          "[Lon]": -81.66,
          "[Assets]": 640
        },
        {
          "asset_register[Community]": "Alpine Village",
          "[Lat]": -36.87,
          "[Lon]": 147.28,
          "[Assets]": 210
        }
      ]
    },
    {
      "id": "coverage-map",
      "component": "UniverusChoropleth",
      "grid": {
        "colSpan": 7
      },
      "query": {
        "dax": "EVALUATE\nVAR ByCommunity =\n  ADDCOLUMNS(\n    SUMMARIZECOLUMNS('asset_register'[Community], \"Assessed\", [Assessed Assets] + 0, \"Assets\", [Asset Count]),\n    \"Code\", SWITCH('asset_register'[Community], \"Manhasset-Lakeville Water District\", \"US-NY\", \"City of Jacksonville\", \"US-FL\", \"Gibsons\", \"CA-BC\", \"Falls Creek\", \"AU-VIC\", \"Mt Buller\", \"AU-VIC\", \"Lake Mountain\", \"AU-VIC\", BLANK())\n  )\nRETURN\n  ADDCOLUMNS(\n    GROUPBY(FILTER(ByCommunity, NOT ISBLANK([Code])), [Code], \"Assessed Assets\", SUMX(CURRENTGROUP(), [Assessed]), \"Region Assets\", SUMX(CURRENTGROUP(), [Assets])),\n    \"Coverage\", DIVIDE([Assessed Assets], [Region Assets]),\n    \"Region\", SWITCH([Code], \"US-NY\", \"New York\", \"US-FL\", \"Florida\", \"CA-BC\", \"British Columbia\", \"AU-VIC\", \"Victoria (Australia)\", [Code])\n  )\nORDER BY [Coverage] DESC"
      },
      "fields": {
        "region": "[Code]",
        "value": "[Coverage]",
        "label": "[Region]",
        "tooltips": [
          {
            "field": "[Region Assets]",
            "label": "Assets",
            "format": {
              "style": "integer"
            }
          }
        ]
      },
      "props": {
        "title": "Assessment coverage by state / province",
        "subtitle": "Choropleth · share of assets with a condition assessment",
        "info": "Share of each region’s assets that have a condition assessment (a rate, so large regions do not win by size). Communities are placed in their state or province; regions outside North America are listed under the map.",
        "calc": "Σ[Assessed Assets] ÷ Σ[Asset Count] by region",
        "geo": {
          "set": "north-america"
        },
        "classes": "quantize",
        "classCount": 4,
        "regionLabel": "State / province",
        "valueLabel": "Coverage",
        "format": {
          "style": "percent",
          "decimals": 0
        },
        "export": {
          "fileName": "coverage-by-region"
        }
      },
      "sample": [
        {
          "[Code]": "US-NY",
          "[Region]": "New York",
          "[Coverage]": 0.42,
          "[Region Assets]": 1760
        },
        {
          "[Code]": "US-FL",
          "[Region]": "Florida",
          "[Coverage]": 0.18,
          "[Region Assets]": 1040
        },
        {
          "[Code]": "CA-BC",
          "[Region]": "British Columbia",
          "[Coverage]": 0.86,
          "[Region Assets]": 3080
        },
        {
          "[Code]": "US-WA",
          "[Region]": "Washington",
          "[Coverage]": 0.64,
          "[Region Assets]": 2420
        },
        {
          "[Code]": "CA-ON",
          "[Region]": "Ontario",
          "[Coverage]": 0.55,
          "[Region Assets]": 2150
        },
        {
          "[Code]": "AU-VIC",
          "[Region]": "Victoria (Australia)",
          "[Coverage]": 0.91,
          "[Region Assets]": 3230
        }
      ]
    },
    {
      "id": "coverage-tiles",
      "component": "UniverusChoropleth",
      "grid": {
        "colSpan": 5
      },
      "query": {
        "dax": "EVALUATE\nVAR ByCommunity =\n  ADDCOLUMNS(\n    SUMMARIZECOLUMNS('asset_register'[Community], \"Assessed\", [Assessed Assets] + 0, \"Assets\", [Asset Count]),\n    \"Code\", SWITCH('asset_register'[Community], \"Manhasset-Lakeville Water District\", \"US-NY\", \"City of Jacksonville\", \"US-FL\", \"Gibsons\", \"CA-BC\", \"Falls Creek\", \"AU-VIC\", \"Mt Buller\", \"AU-VIC\", \"Lake Mountain\", \"AU-VIC\", BLANK())\n  )\nRETURN\n  ADDCOLUMNS(\n    GROUPBY(FILTER(ByCommunity, NOT ISBLANK([Code])), [Code], \"Assessed Assets\", SUMX(CURRENTGROUP(), [Assessed]), \"Region Assets\", SUMX(CURRENTGROUP(), [Assets])),\n    \"Tile Coverage\", DIVIDE([Assessed Assets], [Region Assets])\n  )\nORDER BY [Tile Coverage] DESC"
      },
      "fields": {
        "region": "[Code]",
        "value": "[Tile Coverage]"
      },
      "props": {
        "title": "Coverage, tile map",
        "subtitle": "Equal-area cartogram · every region one tile",
        "info": "The same coverage on a tile grid: every state and province is one tile, so small regions are as visible as large ones.",
        "calc": "Σ[Assessed Assets] ÷ Σ[Asset Count] by region",
        "geo": {
          "set": "north-america"
        },
        "shape": "tiles",
        "classes": "quantize",
        "classCount": 4,
        "regionLabel": "State / province",
        "valueLabel": "Coverage",
        "format": {
          "style": "percent",
          "decimals": 0
        },
        "export": {
          "fileName": "coverage-tiles"
        }
      },
      "sample": [
        {
          "[Code]": "US-NY",
          "[Tile Coverage]": 0.42
        },
        {
          "[Code]": "US-FL",
          "[Tile Coverage]": 0.18
