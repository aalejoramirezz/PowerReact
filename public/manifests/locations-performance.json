{
  "$schema": "./manifest.schema.json",
  "schemaVersion": 1,
  "id": "locations-performance",
  "title": "Locations & Performance (manifest)",
  "eyebrow": "Asset Management · manifest",
  "description": "KPI variants (trend, bullet against target, IBCS variance) and maps: work requests at their exact coordinates, communities on a globe, assessment coverage by state / province as a choropleth and a tile map. Sample rows are illustrative.",
  "theme": "auto",
  "dataSource": {
    "workspaceId": "ef45c53d-42d4-48c6-be79-380b8d890c80",
    "semanticModelId": "0db033d0-4f4e-4d72-a280-007d6f17e2ec"
  },
  "layout": {
    "columns": 12,
    "rowMinHeight": 120
  },
  "visuals": [
    {
      "id": "raised-trend",
      "component": "UniverusKpiTrend",
      "grid": {
        "colSpan": 4
      },
      "query": {
        "dax": "EVALUATE\nFILTER(\n  SUMMARIZECOLUMNS(\n    'Date'[Year Month],\n    FILTER(ALL('Date'[Date]), 'Date'[Date] >= EDATE(DATE(YEAR(TODAY()), MONTH(TODAY()), 1), -12) && 'Date'[Date] < DATE(YEAR(TODAY()), MONTH(TODAY()), 1)),\n    \"Raised\", [WRs Raised],\n    \"Month Start\", MIN('Date'[Date])\n  ),\n  NOT ISBLANK([Raised])\n)\nORDER BY [Month Start]"
      },
      "fields": {
        "category": "'Date'[Year Month]",
        "value": "[Raised]"
      },
      "props": {
        "title": "Work requests raised",
        "icon": "trending-up",
        "goodWhen": "lower",
        "periodLabel": "Last 12 full months",
        "info": "Work requests raised each month over the last twelve complete months; the headline is the latest month, the delta compares it with the month before.",
        "calc": "[WRs Raised] by month",
        "format": {
          "style": "integer"
        }
      },
      "sample": [
        {
          "Date[Year Month]": "Oct 2025",
          "[Raised]": 21,
          "[Month Start]": "2025-10-01T00:00:00"
        },
        {
          "Date[Year Month]": "Nov 2025",
          "[Raised]": 26,
          "[Month Start]": "2025-11-01T00:00:00"
