    {
      "id": "condition",
      "component": "UniverusBoxplot",
      "grid": {
        "colSpan": 5
      },
      "query": {
        "dax": "EVALUATE\nSUMMARIZECOLUMNS(\n  'asset_class_group'[Asset_Class_Group],\n  \"Min\", MINX(FILTER('asset_register', 'asset_register'[Condition_Index] > 0), 'asset_register'[Condition_Index]),\n  \"Q1\", PERCENTILEX.INC(FILTER('asset_register', 'asset_register'[Condition_Index] > 0), 'asset_register'[Condition_Index], 0.25),\n  \"Median\", PERCENTILEX.INC(FILTER('asset_register', 'asset_register'[Condition_Index] > 0), 'asset_register'[Condition_Index], 0.5),\n  \"Q3\", PERCENTILEX.INC(FILTER('asset_register', 'asset_register'[Condition_Index] > 0), 'asset_register'[Condition_Index], 0.75),\n  \"Max\", MAXX(FILTER('asset_register', 'asset_register'[Condition_Index] > 0), 'asset_register'[Condition_Index]),\n  \"Mean\", AVERAGEX(FILTER('asset_register', 'asset_register'[Condition_Index] > 0), 'asset_register'[Condition_Index]),\n  \"Assessed\", COUNTROWS(FILTER('asset_register', 'asset_register'[Condition_Index] > 0))\n)\nORDER BY [Median] DESC"
      },
      "fields": {
        "category": "'asset_class_group'[Asset_Class_Group]",
        "min": "[Min]",
        "q1": "[Q1]",
        "median": "[Median]",
        "q3": "[Q3]",
        "max": "[Max]",
        "mean": "[Mean]",
        "count": "[Assessed]"
      },
      "crossFilter": {
        "field": "'asset_class_group'[Asset_Class_Group]"
      },
      "props": {
        "title": "Condition index by group",
        "subtitle": "Assessed assets · quartiles, range and mean",
        "info": "The spread of the condition index across assessed assets in each group: the box holds the middle half, the line is the median, the diamond the mean, whiskers reach the lowest and highest scores. Statistics are computed by the engine.",
        "calc": "PERCENTILEX.INC over assets with Condition_Index > 0",
        "categoryLabel": "Group",
        "format": {
          "style": "integer"
        },
        "export": {
          "fileName": "condition-distribution"
        }
      },
