    {
      "id": "throughput",
      "component": "UniverusDotPlot",
      "grid": {
        "colSpan": 6
      },
      "query": {
        "dax": "EVALUATE\nTOPN(\n  8,\n  FILTER(\n    SUMMARIZECOLUMNS(\n      'work_request'[Service_Type],\n      \"Raised\", CALCULATE(COUNTROWS('work_request'), 'work_request'[Raised_Date] >= TODAY() - 89, 'work_request'[Raised_Date] < TODAY() + 1) + 0,\n      \"Closed\", CALCULATE(COUNTROWS('work_request'), 'work_request'[Closed_Date] >= TODAY() - 89, 'work_request'[Closed_Date] < TODAY() + 1) + 0\n    ),\n    [Raised] + [Closed] > 0\n  ),\n  [Raised] + [Closed], DESC\n)\nORDER BY [Raised] DESC"
      },
      "fields": {
        "category": "'work_request'[Service_Type]",
        "from": "[Raised]",
        "to": "[Closed]"
      },
      "crossFilter": {
        "field": "'work_request'[Service_Type]"
      },
      "props": {
        "title": "Raised vs closed by service type",
        "subtitle": "Last 90 days · closing more than raised shrinks the backlog",
        "info": "For each service type, requests raised (hollow) and closed (solid) in the last 90 days. A teal connector means more were closed than raised; red means the backlog grew.",
        "calc": "COUNTROWS(work_request) by Raised_Date and Closed_Date, last 90 days",
        "fromLabel": "Raised",
        "toLabel": "Closed",
        "goodWhen": "higher",
        "categoryLabel": "Service type",
        "format": {
          "style": "integer"
        },
        "export": {
          "fileName": "raised-vs-closed"
