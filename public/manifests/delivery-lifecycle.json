    {
      "id": "warranties",
      "component": "UniverusTimeline",
      "grid": {
        "colSpan": 6
      },
      "query": {
        "dax": "EVALUATE\nFILTER(\n  SUMMARIZECOLUMNS(\n    'asset_class'[Asset_Class],\n    'warranty'[warranty_name],\n    \"Start\", MIN('warranty'[warranty_start_date]),\n    \"End\", MAX('warranty'[warranty_end_date]),\n    \"Assets\", COUNTROWS('warranty'),\n    \"Tone\", VAR e = MAX('warranty'[warranty_end_date]) RETURN IF(ISBLANK(e), BLANK(), SWITCH(TRUE(), e < TODAY(), \"bad\", e < TODAY() + 365, \"warn\", \"ok\"))\n  ),\n  [End] <= TODAY() + 10 * 365\n)\nORDER BY 'asset_class'[Asset_Class], [Start]"
      },
      "fields": {
        "item": "'warranty'[warranty_name]",
        "start": "[Start]",
        "end": "[End]",
        "lane": "'asset_class'[Asset_Class]",
        "tone": "[Tone]",
        "tooltips": [
          {
            "field": "[Assets]",
            "label": "Assets covered",
            "format": {
              "style": "integer"
            }
          }
        ]
      },
      "props": {
        "title": "Warranty coverage",
        "subtitle": "By asset class · lapsed and ending within 10 years",
        "info": "Each bar is a warranty, from its start to its end date, grouped by asset class. Red warranties have lapsed, amber end within a year, teal are active. Warranties ending more than ten years out are left out to keep the scale readable.",
        "calc": "MIN(warranty_start_date) → MAX(warranty_end_date) per warranty; tone against TODAY()",
        "toneLabels": {
          "ok": "Active",
          "warn": "Ends within a year",
          "bad": "Lapsed"
        },
        "categoryLabel": "Warranty",
        "laneLabel": "Asset class",
        "export": {
