{
  "$schema": "./manifest.schema.json",
  "schemaVersion": 1,
  "id": "delivery-lifecycle",
  "title": "Delivery & Lifecycle (manifest)",
  "eyebrow": "Asset Management · manifest",
  "description": "Flows, hierarchies, calendars, lifecycles and distributions: backlog bridge, daily intake calendar, inventory treemap, condition boxplot, raised vs closed dot plot, lollipop ranking, funding gap and warranty timeline. Sample rows are illustrative.",
  "theme": "auto",
  "dataSource": {
    "workspaceId": "ef45c53d-42d4-48c6-be79-380b8d890c80",
    "semanticModelId": "0db033d0-4f4e-4d72-a280-007d6f17e2ec"
  },
  "layout": {
    "columns": 12,
    "rowMinHeight": 120
  },
  "filters": [
    {
      "field": "'asset_class_group'[Asset_Class_Group]",
      "label": "Class group",
      "mode": "dropdown"
    }
  ],
  "visuals": [
    {
      "id": "bridge",
      "component": "UniverusWaterfall",
      "grid": {
        "colSpan": 5
      },
      "query": {
        "dax": "EVALUATE\nVAR StartOpen = [Open WRs 7 Days Ago]\nVAR EndOpen = [Open WRs]\nVAR Raised = CALCULATE(COUNTROWS('work_request'), 'work_request'[Raised_Date] >= TODAY() - 6, 'work_request'[Raised_Date] < TODAY() + 1)\nVAR Closed = CALCULATE(COUNTROWS('work_request'), 'work_request'[Closed_Date] >= TODAY() - 6, 'work_request'[Closed_Date] < TODAY() + 1)\nRETURN\n  UNION(\n    ROW(\"Order\", 1, \"Step\", \"A week ago\", \"Kind\", \"start\", \"Value\", StartOpen),\n    ROW(\"Order\", 2, \"Step\", \"Raised\", \"Kind\", \"delta\", \"Value\", Raised),\n    ROW(\"Order\", 3, \"Step\", \"Closed\", \"Kind\", \"delta\", \"Value\", -Closed),\n    ROW(\"Order\", 4, \"Step\", \"Other\", \"Kind\", \"delta\", \"Value\", EndOpen - StartOpen - Raised + Closed),\n    ROW(\"Order\", 5, \"Step\", \"Open now\", \"Kind\", \"end\", \"Value\", EndOpen)\n  )\nORDER BY [Order]"
      },
      "fields": {
        "category": "[Step]",
        "value": "[Value]",
        "kind": "[Kind]"
      },
      "props": {
        "title": "Backlog bridge",
        "subtitle": "Open work requests · last 7 days",
        "info": "How the open backlog moved this week: requests raised add to it, closures take away, and \"Other\" (cancellations, merges, reopenings) reconciles the two levels. Fewer open requests is better.",
        "calc": "[Open WRs 7 Days Ago] → raised − closed ± other → [Open WRs]",
        "goodWhen": "lower",
        "baseline": "auto",
        "categoryLabel": "Step",
        "format": {
          "style": "integer"
        },
        "export": {
          "fileName": "backlog-bridge"
        }
      },
      "sample": [
        {
          "[Order]": 1,
          "[Step]": "A week ago",
          "[Kind]": "start",
          "[Value]": 196
        },
        {
          "[Order]": 2,
          "[Step]": "Raised",
          "[Kind]": "delta",
          "[Value]": 5
        },
        {
          "[Order]": 3,
          "[Step]": "Closed",
          "[Kind]": "delta",
          "[Value]": -4
        },
        {
          "[Order]": 4,
          "[Step]": "Other",
          "[Kind]": "delta",
          "[Value]": 0
        },
        {
          "[Order]": 5,
          "[Step]": "Open now",
          "[Kind]": "end",
          "[Value]": 197
        }
      ]
    },
    {
      "id": "intake",
      "component": "UniverusCalendarHeatmap",
      "grid": {
        "colSpan": 7
      },
      "query": {
        "dax": "EVALUATE\nSUMMARIZECOLUMNS(\n  'Date'[Date],\n  FILTER(ALL('Date'[Date]), 'Date'[Date] > EDATE(TODAY(), -6) && 'Date'[Date] <= TODAY()),\n  \"Raised\", [WRs Raised] + 0\n)\nORDER BY 'Date'[Date]"
      },
      "fields": {
        "date": "'Date'[Date]",
        "value": "[Raised]"
      },
      "crossFilter": {
        "field": "'Date'[Date]"
      },
      "props": {
        "title": "Work requests raised per day",
        "subtitle": "Last six months · click a day to filter",
        "info": "Daily intake of work requests by raised date. Darker days had more requests; weekends and quiet spells show as gaps. Click a day to see what was raised then.",
        "calc": "[WRs Raised] by Date",
        "valueLabel": "Raised",
        "format": {
          "style": "integer"
        },
        "export": {
          "fileName": "requests-per-day"
        }
      },
