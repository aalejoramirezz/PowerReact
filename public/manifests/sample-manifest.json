    {
      "id": "classes",
      "component": "UniverusDataTable",
      "grid": {
        "colSpan": 12
      },
      "query": {
        "dax": "EVALUATE\nSUMMARIZECOLUMNS(\n  'asset_class'[Asset_Class],\n  'asset_class_group'[Asset_Class_Group],\n  \"Assets\", [Asset Count (All States)],\n  \"Assessed\", [Assets Assessed For Condition],\n  \"Assessed Share\", DIVIDE([Assets Assessed For Condition], [Asset Count (All States)]),\n  \"Due For Renewal\", [Assets Due For Renewal]\n)\nORDER BY [Assets] DESC"
      },
      "fields": {
        "columns": [
          {
            "field": "'asset_class'[Asset_Class]",
            "label": "Asset Class"
          },
          {
            "field": "'asset_class_group'[Asset_Class_Group]",
            "label": "Group"
          },
          {
            "field": "[Assets]",
            "label": "Inventory",
            "kind": "number"
          },
          {
            "field": "[Assessed]",
            "label": "Condition Assessed",
            "kind": "meter",
            "ratioField": "[Assessed Share]"
          },
          {
            "field": "[Due For Renewal]",
            "label": "Renewals",
            "kind": "status",
            "suffix": "due",
            "tone": "warn",
            "emptyLabel": "None due"
          }
        ],
        "rowKey": "'asset_class'[Asset_Class]"
      },
      "crossFilter": {
        "field": "'asset_class'[Asset_Class]"
      },
      "props": {
        "title": "Asset classes",
        "subtitle": "Inventory, condition and renewals by class",
        "export": {
          "source": "query",
          "fileName": "asset-classes"
        },
        "emptyMessage": "No asset classes match the current cross-filters.",
        "info": "Every asset class in scope. Click a row to cross-filter; the export carries the raw query rows.",
