    {
      "id": "condition-coverage",
      "component": "UniverusKpiHero",
      "grid": {
        "colSpan": 7
      },
      "query": {
        "dax": "EVALUATE\nROW(\n  \"Assessed Share\", DIVIDE([Assets Assessed For Condition], [Asset Count (All States)]),\n  \"Total Assets\", [Asset Count (All States)],\n  \"Assessed\", [Assets Assessed For Condition],\n  \"Due For Renewal\", [Assets Due For Renewal],\n  \"Due Share\", DIVIDE([Assets Due For Renewal], [Asset Count (All States)])\n)"
      },
      "fields": {
        "value": "[Assessed Share]",
        "meter": "[Due Share]",
        "metrics": [
          {
            "label": "Assets in scope",
            "field": "[Total Assets]"
          },
          {
            "label": "Condition assessed",
            "field": "[Assessed]"
          },
          {
            "label": "Due for renewal",
            "field": "[Due For Renewal]"
          }
        ]
      },
      "props": {
        "title": "Condition coverage",
        "format": {
          "style": "percent",
          "decimals": 1
        },
        "meterLabel": "Due for renewal",
        "info": "Share of the assets in scope with at least one condition assessment; the meter shows the share due for renewal.",
        "calc": "Assessed ÷ assets · due for renewal ÷ assets ([Asset Count (All States)])"
      },
