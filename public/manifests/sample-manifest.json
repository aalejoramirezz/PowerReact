{
  "$schema": "./manifest.schema.json",
  "schemaVersion": 1,
  "id": "asset-portfolio",
  "title": "Asset Portfolio (manifest)",
  "eyebrow": "Asset Management · manifest",
  "description": "The asset register as a declarative manifest: four KPIs, a hero, a spotlight, a donut, a ranking and a table, cross-filtering each other.",
