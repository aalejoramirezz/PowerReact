{
  "name": "powerreact",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run elements:build && concurrently -n \"EL,API,WEB\" -c \"magenta,blue,green\" \"npm run elements:watch\" \"npm run server\" \"npm run client\"",
    "server": "tsx watch server/index.ts",
    "client": "vite",
    "elements:build": "npm run build -w @powerreact/univerus-elements",
    "elements:watch": "npm run watch -w @powerreact/univerus-elements",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm run elements:build && tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.build.json",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "lint": "oxlint",
    "pretypecheck": "npm run elements:build",
    "typecheck": "tsc -b",
    "pretest": "npm run elements:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "manifest:schema": "tsx scripts/generate-manifest-schema.ts",
    "skills:sync": "node scripts/sync-agent-skills.mjs",
    "skills:check": "node scripts/sync-agent-skills.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "lucide-react": "^1.49.0",
    "powerbi-client": "^2.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stencil/core": "^4.45.2",
    "@stencil/react-output-target": "^1.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
